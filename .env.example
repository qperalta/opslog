# Deploy script (scripts/deploy.sh) needs these:
DOCKER_IMAGE=queperalta/opslog
RENDER_DEPLOY_HOOK_URL=

# On Render (production)
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=

# Demo account (optional): seeds two weeks of history at startup
OPSLOG_DEMO_ENABLED=
OPSLOG_DEMO_RESET=
OPSLOG_DEMO_EMAIL=
OPSLOG_DEMO_PASSWORD=
